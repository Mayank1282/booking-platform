APP_NAME="Slotwise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Local development uses SQLite (zero setup, no server needed).
# Production uses MySQL — set DB_CONNECTION=mysql and fill the values below.
# All migrations and queries are written to be compatible with both.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=booking_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (Brevo SMTP relay) ---------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe ---------------------------------------------------------------
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
# Leave blank to use the built-in simulated gateway (full lifecycle still works).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# How long a card refund takes to reach the client, per Stripe's guidance.
# Quoted verbatim in the cancellation and refund emails.
STRIPE_REFUND_DAYS_MIN=5
STRIPE_REFUND_DAYS_MAX=10

# Razorpay. The key id is public (used by the checkout widget); the secret is
# server-only. The webhook secret is NOT issued by Razorpay — you type a value
# into the dashboard's Secret field and mirror it here.
RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=

# --- Marketplace pricing ----------------------------------------------
# Basis points: 100 bps = 1%. Every value here has a working default in
# config/booking.php, so the app runs without them — they are listed so the
# knobs are discoverable rather than buried in config.

# The platform's commission, added on top of the provider's price.
# 1000 bps = 10%. A provider listing 800 receives 800; the client pays 880.
PLATFORM_FEE_BPS=1000

# Payment processing, passed on to the client and retained on a refund.
# Stripe keeps its fee when a charge is reversed, so without this every
# cancellation would cost the platform real money for a service nobody
# received. Deliberately a little above Stripe's actual ~2.9% + 1% conversion
# so the refund-side deduction is covered too.
# Applies to Stripe only — Razorpay settles INR natively with no conversion.
PROCESSING_FEE_BPS=490
PROCESSING_FEE_FIXED=30

# Quoted verbatim in the cancellation and refund emails.
STRIPE_REFUND_DAYS_MIN=5
STRIPE_REFUND_DAYS_MAX=10

# How long an unpaid booking holds its slot before the reservation lapses.
BOOKING_HOLD_MINUTES=15

# Reuse the MySQL connection between requests. Against a managed database the
# TLS handshake and auth exchange cost more than the queries do (~350ms here).
# Leave off locally: a handshake to 127.0.0.1 is free and a stale connection is
# only confusing to debug.
DB_PERSISTENT=false

# Brevo HTTP API. Render blocks outbound SMTP, so production must use
# MAIL_MAILER=brevo with this key rather than MAIL_MAILER=smtp.
BREVO_API_KEY=
